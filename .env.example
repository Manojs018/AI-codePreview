# =============================================================================
# AI Code Review Platform - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# GitHub OAuth Configuration
# -----------------------------------------------------------------------------
# Get these from: https://github.com/settings/developers
# Create a new OAuth App with:
# - Homepage URL: http://localhost:3001
# - Callback URL: http://localhost:3000/api/auth/github/callback

GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# -----------------------------------------------------------------------------
# OpenAI Configuration
# -----------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys

OPENAI_API_KEY=sk-your-openai-api-key-here

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
# Generate random strings for these (use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")

JWT_SECRET=your-jwt-secret-here-use-random-string
JWT_REFRESH_SECRET=your-refresh-secret-here-use-random-string
ENCRYPTION_KEY=your-encryption-key-here-use-random-string
WEBHOOK_SECRET=your-webhook-secret-here-use-random-string

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database

# For Docker (default):
DATABASE_URL=postgresql://postgres:postgres_dev_password@postgres:5432/ai_code_review

# For local PostgreSQL:
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/ai_code_review

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Redis connection string

# For Docker (default):
REDIS_URL=redis://redis:6379

# For local Redis:
# REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# RabbitMQ Configuration
# -----------------------------------------------------------------------------
# RabbitMQ connection string

# For Docker (default):
RABBITMQ_URL=amqp://admin:admin_dev_password@rabbitmq:5672

# For local RabbitMQ:
# RABBITMQ_URL=amqp://guest:guest@localhost:5672

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------

# Environment (development, staging, production)
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:3001

# API Gateway Port
PORT=3000

# Logging Level (error, warn, info, debug)
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Service Ports (for development)
# -----------------------------------------------------------------------------

API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
GITHUB_SERVICE_PORT=3002
CODE_ANALYSIS_PORT=3003
AI_REVIEW_PORT=3004
FEEDBACK_PUBLISHER_PORT=3005
ANALYTICS_PORT=3006

# -----------------------------------------------------------------------------
# External Services (Optional)
# -----------------------------------------------------------------------------

# Sentry (Error Tracking)
# SENTRY_DSN=your-sentry-dsn-here

# Slack (Notifications)
# SLACK_WEBHOOK_URL=your-slack-webhook-url-here

# SendGrid (Email)
# SENDGRID_API_KEY=your-sendgrid-api-key-here
# SENDGRID_FROM_EMAIL=noreply@yourcompany.com

# -----------------------------------------------------------------------------
# Production Configuration (Only for production deployment)
# -----------------------------------------------------------------------------

# AWS Configuration
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# S3 Bucket (for artifacts)
# S3_BUCKET_NAME=ai-code-review-artifacts

# CloudFront Distribution
# CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------

# Enable/disable features
ENABLE_AI_REVIEW=true
ENABLE_ANALYTICS=true
ENABLE_NOTIFICATIONS=false
ENABLE_WEBHOOKS=true

# AI Configuration
AI_MODEL=gpt-4-turbo-preview
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.3

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=100

# Cache TTL (seconds)
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=3600
CACHE_TTL_LONG=86400

# -----------------------------------------------------------------------------
# Development Tools
# -----------------------------------------------------------------------------

# ngrok (for local webhook testing)
# NGROK_AUTH_TOKEN=your-ngrok-auth-token
# NGROK_DOMAIN=your-custom-domain.ngrok.io

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# 1. Never commit this file with real values to version control
# 2. Use strong, random values for all secrets
# 3. Rotate secrets regularly in production
# 4. Use environment-specific .env files (.env.development, .env.production)
# 5. For production, use a secrets manager (AWS Secrets Manager, HashiCorp Vault)
# =============================================================================
