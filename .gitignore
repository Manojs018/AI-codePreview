# .gitignore

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Environment variables
.env
.env.local
.env.development
.env.production
.env.test

# Build outputs
dist/
build/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Testing
coverage/
.nyc_output/
*.lcov
.jest/

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Docker
.docker/
docker-compose.override.yml

# Database
*.sqlite
*.db
pgdata/

# Temporary files
tmp/
temp/
*.tmp

# OS files
.DS_Store
Thumbs.db

# Production
.next/
out/

# Misc
.cache/
.parcel-cache/
.eslintcache

# Secrets
*.pem
*.key
*.cert
secrets/

# Backup files
*.bak
*.backup

# Redis dump
dump.rdb

# TypeScript
*.tsbuildinfo
